# Defaults point at the live API (api-production-83900.up.railway.app). For local development:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# EXPO_PUBLIC_APP_URI must keep the same host as the API's AUTH_DOMAIN.
# Never put keys in this file: everything EXPO_PUBLIC_* is readable by anyone who has the app.
# Paid RPC keys (Helius etc.) go only in the API's SOLANA_RPC_URL. The app refuses to start if this looks like one.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
