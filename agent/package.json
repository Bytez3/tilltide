{
  "name": "@tilltide/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "create-points-mint": "tsx --env-file-if-exists=.env scripts/create-points-mint.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "tsx test/e2e/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@hono/node-server": "^2.1.5",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.5.0",
    "@tilltide/agent-pay-kit": "workspace:*",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
