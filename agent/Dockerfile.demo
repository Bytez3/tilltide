# Hosted judge demo: the browser sandbox (local Solana validator, stand-in PayPal, its own Postgres)
# with the web app served from the same origin. Nothing in it touches devnet, mainnet or real PayPal.
# Build from the repo root:
#   docker build -f agent/Dockerfile.demo --build-arg DEMO_URL=https://demo.tilltide.bytez3.com .
FROM node:22-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.18.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY agent/package.json agent/
COPY packages/agent-pay-kit/package.json packages/agent-pay-kit/
COPY apps/seeker-app/package.json apps/seeker-app/

# The web app, built for this demo's address with the browser test wallet switched on.
FROM base AS web
ARG DEMO_URL=https://demo.tilltide.bytez3.com
RUN pnpm install --frozen-lockfile --filter @tilltide/seeker-app...
COPY packages/agent-pay-kit packages/agent-pay-kit
COPY apps/seeker-app apps/seeker-app
RUN cd apps/seeker-app && \
    EXPO_PUBLIC_SANDBOX=1 EXPO_PUBLIC_API_URL=$DEMO_URL EXPO_PUBLIC_SOLANA_RPC_URL=$DEMO_URL/sandbox/rpc EXPO_PUBLIC_APP_URI=$DEMO_URL \
    npx expo export -p web --output-dir /web

FROM base
# Agave 4 needs io_uring, which containers usually block; 3.0 runs anywhere.
ARG AGAVE=v3.0.14
RUN apt-get update && apt-get install -y --no-install-recommends postgresql bzip2 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSfL https://github.com/anza-xyz/agave/releases/download/$AGAVE/solana-release-x86_64-unknown-linux-gnu.tar.bz2 \
    | tar -xj -C /usr/local --strip-components=1 solana-release/bin/solana-test-validator solana-release/bin/solana
RUN pnpm install --frozen-lockfile --filter @tilltide/agent... --prod=false
COPY packages/agent-pay-kit packages/agent-pay-kit
COPY agent agent
COPY --from=web /web /web

ENV NODE_ENV=production SANDBOX_WEB_DIR=/web
EXPOSE 8787
CMD ["sh", "agent/demo-start.sh"]
