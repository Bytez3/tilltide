{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm install --frozen-lockfile --filter @tilltide/agent..."
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @tilltide/agent migrate",
    "startCommand": "pnpm --filter @tilltide/agent start",
    "healthcheckPath": "/health"
  }
}
