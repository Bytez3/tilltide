PORT=8787
DATABASE_URL=postgres://tilltide:tilltide@localhost:5432/tilltide

# devnet until M4
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Loyalty points mint + its authority (JSON byte array from `solana-keygen`). Server-side only.
# Create both with: pnpm --filter @tilltide/agent create-points-mint
POINTS_MINT=
POINTS_AUTHORITY_SECRET=

ANTHROPIC_API_KEY=
# Claude model for the agent, its effort, and how many questions each shop can ask per day.
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=low
AGENT_DAILY_LIMIT=50

# PayPal checkout as a second rail, for customers without a crypto wallet.
# Sandbox app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
# Where PayPal sends the customer back after paying. Must be reachable from their phone.
PUBLIC_URL=http://localhost:8787

# Sign In With Solana domain (required). Must equal the host of EXPO_PUBLIC_APP_URI in the app.
# Use a domain you control before piloting with real shops.
AUTH_DOMAIN=github.com
