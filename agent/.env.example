PORT=8787
DATABASE_URL=postgres://tilltide:tilltide@localhost:5432/tilltide

# devnet until M4
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Loyalty points mint + its authority (JSON byte array from `solana-keygen`). Server-side only.
# Create both with: pnpm --filter @tilltide/agent create-points-mint
POINTS_MINT=
POINTS_AUTHORITY_SECRET=

ANTHROPIC_API_KEY=
# Claude model for the agent, its effort, and how many questions each shop can ask per day.
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=low
AGENT_DAILY_LIMIT=50
# Optional cap across all shops; the public demo sets it, since anyone can make a shop there.
# AGENT_GLOBAL_DAILY_LIMIT=300
# Assistant questions a month: included with Tilltide's fee, and on the Plus plan. Then top-up credits.
AGENT_MONTHLY_INCLUDED=100
AGENT_MONTHLY_PLUS=1500
# Most the AI may cost per day across every shop, in pounds; alerts at 50%, 80% and 100%. 'off' removes it.
AI_DAILY_BUDGET_GBP=10
# Turns on /admin/usage (AI cost against fee income per shop) and plan/credit changes. Use a long random value.
# ADMIN_TOKEN=

# PayPal checkout as a second rail, for customers without a crypto wallet.
# Sandbox app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
# Where PayPal sends the customer back after paying. Must be reachable from their phone.
PUBLIC_URL=http://localhost:8787
# Tilltide as a PayPal platform (PayPal-first): our partner merchant id from PayPal turns on "Connect
# PayPal" onboarding for shops and platform fees on their sales; BN code is PayPal's attribution id.
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BN_CODE=
PAYPAL_FEE_BPS=50
# Refuse PayPal sales until a shop connects its own PayPal (defaults to true when PAYPAL_ENV=live).
PAYPAL_REQUIRE_CONNECTED=false

# Sign In With Solana domain (required). Must equal the host of EXPO_PUBLIC_APP_URI in the app.
# Use a domain you control before piloting with real shops.
AUTH_DOMAIN=api-production-83900.up.railway.app

# Behind Cloudflare: a Transform Rule adds this as the x-tilltide-origin header. When set, requests
# without it (e.g. straight to the Railway address) are refused. Leave empty when not behind Cloudflare.
ORIGIN_SECRET=

# Tilltide's fee on sweeps, paid to this wallet in the same transaction the owner signs.
# Leave TREASURY_WALLET empty to switch the fee off. 50 basis points = 0.5%.
TREASURY_WALLET=
SWEEP_FEE_BPS=50

# Where to send "needs attention" alerts (a Discord or Slack incoming webhook URL).
ALERT_WEBHOOK_URL=
