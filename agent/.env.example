PORT=8787
DATABASE_URL=postgres://tilltide:tilltide@localhost:5432/tilltide

# devnet until M4
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Loyalty points mint + its authority (JSON byte array from `solana-keygen`). Server-side only.
# Create both with: pnpm --filter @tilltide/agent create-points-mint
POINTS_MINT=
POINTS_AUTHORITY_SECRET=

ANTHROPIC_API_KEY=

# Shared secret the app sends as `x-api-key`. Replace with Sign In With Solana before mainnet.
APP_API_KEY=dev-key
